# PyTriton requires the tritonserver base image
FROM nvcr.io/nvidia/tritonserver:24.12-py3

WORKDIR /app

# Install Python dependencies
RUN pip install --no-cache-dir \
    truefoundry \
    nvidia-pytriton==0.5.10 \
    tensorrt \
    numpy==1.26.4 \
    torch==2.2.0 \
    Pillow==10.3.0

# Copy server code
COPY sfm_server_trt.py .
COPY convert_trt.py .

EXPOSE 8000 8001

CMD ["python3", "sfm_server_trt.py"]
